{
  "name": "browserfly",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in wandering fruit-fly sprite for static websites",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:sweep": "node scripts/sweep.mjs",
    "test:e2e": "node esbuild.config.mjs && playwright test",
    "lint": "eslint .",
    "serve": "node scripts/serve.mjs",
    "docs": "node scripts/params-table.mjs",
    "docs:check": "node scripts/params-table.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vitest": "^5.0.5"
  }
}
